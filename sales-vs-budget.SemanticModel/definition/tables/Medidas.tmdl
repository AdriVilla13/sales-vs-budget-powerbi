table Medidas
	lineageTag: dd55452b-512f-432b-ba5e-fee46d277f58

	measure Ventas = SUM(Ventas[Venta])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 1ac0b8b4-90b8-475f-86f7-91f4b46cd211

	measure Clientes = SUM(Ventas[Clientes])
		formatString: 0
		lineageTag: c84b14a0-2948-452f-911c-9ca71f5ba5b6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Ticket promedio' =
			
			DIVIDE(
			    CALCULATE([Ventas], KEEPFILTERS(Canales[Canal] IN {"Salón", "Mostrador"})),
			    [Clientes]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6741da1f-fa31-41a0-b203-660a1f119f65

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure Presupuesto = SUM(Presupuesto[Presupuesto])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 55671851-4532-4cc9-bda5-7152e4b00735

	measure 'Presupuesto a la fecha' =
			
			VAR UltimaVenta = CALCULATE(MAX(Ventas[Fecha]), ALL(Ventas))
			RETURN
			    CALCULATE([Presupuesto], KEEPFILTERS(Calendario[Fecha] <= UltimaVenta))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 5e2a2c12-930b-4195-b830-eb157a6e8422

	measure '% Cumplimiento' = DIVIDE([Ventas], [Presupuesto a la fecha])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0de97cc5-3bff-4ca1-82ac-959c819e62cd

	measure 'Diferencia vs presupuesto' = [Ventas] - [Presupuesto a la fecha]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: cf04477d-ec94-4d58-9e77-2a8529cf0410

	measure 'Ventas año anterior' =
			
			VAR UltimaVenta = CALCULATE(MAX(Ventas[Fecha]), ALL(Ventas), Ventas[Venta] > 0)
			VAR FechasConDatos =
			    FILTER(VALUES(Calendario[Fecha]), Calendario[Fecha] <= UltimaVenta)
			RETURN
			    IF(
			        HASONEVALUE(Calendario[Año]),
			        CALCULATE([Ventas], SAMEPERIODLASTYEAR(FechasConDatos))
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: db555f28-f455-40fb-9f33-a2fb5c26fe4a

	measure '% Crecimiento vs año anterior' =
			
			DIVIDE([Ventas] - [Ventas año anterior], [Ventas año anterior])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ff536c30-0b09-449a-aadf-3fcacd6a72e2

	measure 'Ventas acumuladas' =
			
			IF(HASONEVALUE(Calendario[Año]), TOTALYTD([Ventas], Calendario[Fecha]))
		lineageTag: a14bd151-b089-44cd-9e56-fd98fa18ca97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto acumulado' =
			
			IF(
			    HASONEVALUE(Calendario[Año]),
			    TOTALYTD([Presupuesto a la fecha], Calendario[Fecha])
			)
		lineageTag: f6a86e1d-c075-4d11-9614-fa1eeb9719d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Cumplimiento acumulado' = DIVIDE([Ventas acumuladas], [Presupuesto acumulado])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 75190e54-dbe3-44c4-9824-00eac5aa3dff

	measure 'Inflación del año' =
			
			LOOKUPVALUE('Inflación'[Inflación], 'Inflación'[Año], SELECTEDVALUE(Calendario[Año]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fb656b98-1e61-4615-a35e-8b51d61beb8d

	measure 'Ventas reales' =
			
			VAR AnioBase = YEAR([Fecha de corte]) - 1
			VAR IndiceBase =
			    CALCULATE(AVERAGE(INPC[INPC]), REMOVEFILTERS(Calendario), Calendario[Año] = AnioBase)
			RETURN
			    SUMX(
			        VALUES(Calendario[AñoMes]),
			        DIVIDE(CALCULATE([Ventas]), CALCULATE(AVERAGE(INPC[INPC])) / IndiceBase)
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0b5092bd-41e5-494c-a019-08e4d6658e22

	measure '% Crecimiento real' =
			
			DIVIDE([Diferencia real vs año anterior], [Ventas reales año anterior])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bd83ae3f-8190-4a22-9b2d-a90f5da7d304

	measure '% Cumplimiento total' = ```
			
			   CALCULATE([% Cumplimiento], REMOVEFILTERS(Canales), REMOVEFILTERS(Turnos), REMOVEFILTERS(Ventas[Canal], Ventas[Turno]))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 41e2351e-1932-44ea-91bf-ac8c941f03d0

	measure 'Diferencia total vs presupuesto' =
			
			CALCULATE(
			    [Diferencia vs presupuesto],
			    REMOVEFILTERS(Canales), REMOVEFILTERS(Turnos),
			    REMOVEFILTERS(Ventas[Canal], Ventas[Turno])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f56bf957-36bc-45ef-9845-4cbb7f4ac702

	measure 'Venta no recuperada vs 2019' =
			
			SUMX(
			    VALUES(Calendario[Año]),
			    MAX(0, [Ventas reales 2019] - [Ventas reales])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b5b7d9e5-6100-4db1-87b5-67133d4ba267

	measure 'Ventas reales 2019' =
			
			CALCULATE([Ventas reales], REMOVEFILTERS(Calendario), Calendario[Año] = 2019)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 358da2eb-56f3-458e-a5ec-35a5c861191c

	measure 'Diferencia real vs 2019' =
			
			SUMX(
			    VALUES(Calendario[Año]),
			    [Ventas reales] - [Ventas reales 2019]
			)
		lineageTag: 31cea39d-c630-4d42-8011-61a63b797fdb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas reales mismo mes 2019' =
			
			CALCULATE(
			    [Ventas reales],
			    REMOVEFILTERS(Calendario),
			    Calendario[Año] = 2019,
			    VALUES(Calendario[MesNum])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 79455cf4-6705-4126-ab5c-8ce83cb01225

	measure 'Diferencia real vs mismo mes 2019' =
			
			SUMX(
			    VALUES(Calendario[AñoMes]),
			    VAR VentasMes = [Ventas reales]
			    RETURN
			        IF(NOT ISBLANK(VentasMes), VentasMes - [Ventas reales mismo mes 2019])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b8b8c2df-8ea3-484c-91f5-abb170143995

	measure 'Fecha de corte' = CALCULATE(MAX(Ventas[Fecha]), ALL(Ventas), Ventas[Venta] > 0)
		formatString: General Date
		lineageTag: 0ee462cf-0abf-4dee-87f5-e82c87abfc6f

	measure 'Ventas a la misma fecha' =
			
			VAR Corte = MONTH([Fecha de corte]) * 100 + DAY([Fecha de corte])
			RETURN
			    CALCULATE([Ventas], KEEPFILTERS(Calendario[MesDia] <= Corte))
		lineageTag: 805fd258-5f06-418d-9195-b2b7013fb2bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas reales a la misma fecha' =
			
			VAR Corte = MONTH([Fecha de corte]) * 100 + DAY([Fecha de corte])
			RETURN
			    CALCULATE([Ventas reales], KEEPFILTERS(Calendario[MesDia] <= Corte))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8a7b3f64-f27a-4a86-94d1-f4b7997876b2

	measure 'Clientes a la misma fecha' =
			
