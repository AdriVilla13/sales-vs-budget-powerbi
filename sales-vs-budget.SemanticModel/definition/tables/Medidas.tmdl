	measure 'Texto base' = "Pesos de " & (YEAR([Fecha de corte]) - 1)
		lineageTag: 38bebbba-0fba-45b4-a735-9e41f18bb147

	measure 'Texto periodo' =
			
			VAR Anio = SELECTEDVALUE(Calendario[Año])
			VAR Meses =
			    CONCATENATEX(
			        SUMMARIZE(Calendario, Calendario[MesNum], Calendario[Mes]),
			        Calendario[Mes], ", ",
			        Calendario[MesNum], ASC
			    )
			RETURN
			    IF(
			        ISFILTERED(Calendario[Mes]),
			        Meses & " " & Anio,
			        IF(
			            Anio = YEAR([Fecha de corte]),
			            "Ene–" & FORMAT([Fecha de corte], "Mmm") & " " & Anio,
			            "Año completo " & Anio
			        )
			    )
		lineageTag: 03a97556-c363-4d0c-b2a6-e4fd7f4d6985

	measure 'Titulo crecimiento' =
			
			"Crecimiento vs año anterior · " & [Texto periodo]
		lineageTag: 3713030c-e91a-4ed4-ac2b-b28339a8f8de

	measure 'Titulo vs 2019' =
			
			"Crecimiento vs 2019 · " & [Texto periodo]
		lineageTag: 1683f199-7dec-46c4-aaae-8b6fca705464

	measure 'texto dif año actual' = "Año actual vs año anterior"
