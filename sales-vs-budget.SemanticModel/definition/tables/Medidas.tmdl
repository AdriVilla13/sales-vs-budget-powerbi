	measure 'Ventas apps con pedidos' =
			
			SUMX(
			    VALUES(Calendario[AñoMes]),
			    IF(
			        NOT ISBLANK([Pedidos]),
			        CALCULATE([Ventas], KEEPFILTERS(Canales[Canal] IN {"Uber", "Rappi"}))
			    )
			)
		lineageTag: 608ad3af-941f-462d-9ad1-7be07fda39a0

